DATABASE_URL=sqlite:///../data/attendance.db
DEVICE_TOKEN=replace-with-a-random-device-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-bytes
RECOGNITION_THRESHOLD=0.52
MIN_FACE_AREA_RATIO=0.03
FACE_DETECTOR=yunet
YUNET_MODEL_PATH=models/yunet/face_detection_yunet_2023mar.onnx
FACE_SCORE_THRESHOLD=0.8
PAD_REAL_THRESHOLD=0.45
PAD_CROP_SCALE=2.7
# Chế độ chống giả mạo: passive (khuyến nghị cho demo mượt mà, dùng MiniFASNetV2), blink (chớp mắt), hoặc off
LIVENESS_MODE=passive
LIVENESS_CLOSED_RATIO=0.75
LIVENESS_WINDOW_S=5.0
LIVENESS_MAX_HZ=10.0
CAMERA_CAPTURE_URL=http://192.168.4.1/capture
CAMERA_DEVICE_ID=esp32-cam-01
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://localhost:8080,http://localhost:5173
CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3})(?::\d+)?$
# Môi trường chạy ứng dụng (development / production)
APP_ENV=development
# Bật hoặc tắt tài liệu API Swagger/ReDoc
ENABLE_API_DOCS=true
# Chuỗi hash PBKDF2 của mật khẩu quản trị viên
ADMIN_PASSWORD_HASH=
# Thời gian sống của Bearer token tính theo giờ (1-24)
TOKEN_TTL_HOURS=8
# Số lần đăng nhập sai tối đa trước khi khóa tạm thời
LOGIN_MAX_ATTEMPTS=5
# Cửa sổ thời gian tính số lần đăng nhập sai (giây)
LOGIN_WINDOW_SECONDS=300
# Thời gian tạm khóa đăng nhập khi vượt ngưỡng (giây)
LOGIN_LOCK_SECONDS=900
# Giới hạn kích thước file tải lên khi nhập dữ liệu (bytes)
MAX_IMPORT_BYTES=2097152
# Ca điểm danh tự mở/đóng theo lịch học; chu kỳ quét của bộ hẹn giờ tính bằng giây (5-300).
# Lịch đang trong giờ học thì ca mở ngay khi lưu, không chờ chu kỳ này.
AUTO_SESSION_ENABLED=true
AUTO_SESSION_INTERVAL_SECONDS=30
# Trích vector khuôn mặt trong tiến trình con để luồng camera không khựng lúc nhận diện.
# Đặt false nếu máy không tạo được tiến trình con.
RECOGNITION_PROCESS=true
# Tinh chỉnh thêm cho cảm biến ESP32-CAM mỗi lần chạy start_esp32.sh, không cần nạp lại firmware.
# Ví dụ: CAMERA_CONTROL_EXTRA="aec2=0 gainceiling=4"
CAMERA_CONTROL_EXTRA=
