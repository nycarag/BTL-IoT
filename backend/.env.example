DATABASE_URL=sqlite:///../data/attendance.db
DEVICE_TOKEN=replace-with-a-random-device-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-bytes
RECOGNITION_THRESHOLD=0.52
MIN_FACE_AREA_RATIO=0.03
FACE_DETECTOR=yunet
YUNET_MODEL_PATH=models/yunet/face_detection_yunet_2023mar.onnx
FACE_SCORE_THRESHOLD=0.8
PAD_REAL_THRESHOLD=0.45
PAD_CROP_SCALE=2.7
CORS_ORIGINS=http://localhost:8000,http://localhost:8080,http://localhost:5173
CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3})(?::\d+)?$
